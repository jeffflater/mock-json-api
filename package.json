{
  "name": "mock-json-api",
  "version": "0.5.0",
  "description": "Mock JSON API server for Node.js with scenario support",
  "main": "mock.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/jeffflater/mock-json-api.git"
  },
  "keywords": [
    "mock",
    "json",
    "api",
    "testing",
    "e2e",
    "rest"
  ],
  "author": "Jeff Flater <jflater.email@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeffflater/mock-json-api/issues"
  },
  "homepage": "https://github.com/jeffflater/mock-json-api",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dummy-json": "^3.0.5",
    "express": "^4.21.0",
    "path-to-regexp": "^6.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "test": "jest --testPathPattern=__tests__ --testPathIgnorePatterns=mcp-server",
    "test:watch": "jest --watch --testPathPattern=__tests__ --testPathIgnorePatterns=mcp-server",
    "test:types": "tsc types.test.ts --noEmit --esModuleInterop --skipLibCheck",
    "test:mcp": "cd mcp-server && npm test"
  }
}
